+
+void ClientListener::on_trust_changed(sendspin::ConnectionTrust trust) {
+    std::fprintf(stderr, "sendspin: connection trust: %s\n",
+                 trust == sendspin::ConnectionTrust::USER ? "paired server" : "unpaired");
+}
+
+void ClientListener::on_pairing_started(const std::string& server_id) {
+    std::fprintf(stderr, "sendspin: pairing started with server %s\n", server_id.c_str());
+}
+
+void ClientListener::on_pairing_succeeded(const std::string& server_id) {
+    std::fprintf(stderr, "sendspin: paired with server %s\n", server_id.c_str());
+}
+
+void ClientListener::on_pairing_failed(const std::string& server_id,
+                                       sendspin::SendspinPairAbortReason reason) {
+    std::fprintf(stderr, "sendspin: pairing with server %s failed (reason %d)\n",
+                 server_id.c_str(), static_cast<int>(reason));
+}
+
+void ClientListener::on_display_pairing_code(const std::string& code,
+                                             sendspin::SendspinPairingCodeFormat /*format*/) {
+    // Only the digits format is offered (see main.cpp); shown 3-3 as the spec recommends.
+    std::fprintf(stderr, "sendspin: pairing code %s-%s, enter it on the server\n",
+                 code.substr(0, 3).c_str(), code.substr(3).c_str());
+}
+
+void ClientListener::on_clear_pairing_code() {
+    std::fprintf(stderr, "sendspin: pairing code withdrawn\n");
+}
