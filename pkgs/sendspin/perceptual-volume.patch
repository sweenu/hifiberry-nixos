diff --git a/src/volume_scale.cpp b/src/volume_scale.cpp
index 6e3c646..433fe64 100644
--- a/src/volume_scale.cpp
+++ b/src/volume_scale.cpp
@@ -1,4 +1,5 @@
 #include "volume_scale.h"
+#include <cmath>
 
 // The Sendspin wire protocol carries volume as 0-100 (Music Assistant's
 // aiosendspin server rejects a client/state whose volume is outside 0-100).
@@ -23,3 +24,34 @@ uint8_t raw_to_sendspin(long raw, long min, long max) {
     if (v > SENDSPIN_VOL_MAX) v = SENDSPIN_VOL_MAX;
     return static_cast<uint8_t>(v);
 }
+
+// amplitude = (volume/100)^1.5, so dB = 20*1.5*log10(volume/100); in
+// hundredths of a decibel the factor is 3000.
+static constexpr double SPEC_DB_FACTOR_MDB = 3000.0;
+
+long sendspin_to_mdb(uint8_t v, const DbRange& range) {
+    if (!range.usable()) return range.min_mdb;
+    if (v == 0) return range.min_mdb;
+    if (v > SENDSPIN_VOL_MAX) v = static_cast<uint8_t>(SENDSPIN_VOL_MAX);
+
+    const double mdb = static_cast<double>(range.reference_mdb()) +
+                       SPEC_DB_FACTOR_MDB * std::log10(static_cast<double>(v) / SENDSPIN_VOL_MAX);
+    const long rounded = std::lround(mdb);
+    if (rounded < range.min_mdb) return range.min_mdb;
+    if (rounded > range.max_mdb) return range.max_mdb;
+    return rounded;
+}
+
+uint8_t mdb_to_sendspin(long mdb, const DbRange& range) {
+    if (!range.usable()) return 0;
+    if (mdb <= range.min_mdb) return 0;
+    if (mdb >= range.reference_mdb()) return static_cast<uint8_t>(SENDSPIN_VOL_MAX);
+
+    const double v = SENDSPIN_VOL_MAX *
+                     std::pow(10.0, static_cast<double>(mdb - range.reference_mdb()) /
+                                        SPEC_DB_FACTOR_MDB);
+    long rounded = std::lround(v);
+    if (rounded < 0) rounded = 0;
+    if (rounded > SENDSPIN_VOL_MAX) rounded = SENDSPIN_VOL_MAX;
+    return static_cast<uint8_t>(rounded);
+}
diff --git a/src/volume_scale.h b/src/volume_scale.h
index b963672..89628d7 100644
--- a/src/volume_scale.h
+++ b/src/volume_scale.h
@@ -1,4 +1,33 @@
 #pragma once
 #include <cstdint>
+
 long sendspin_to_raw(uint8_t v, long min, long max);
 uint8_t raw_to_sendspin(long raw, long min, long max);
+
+// A control's usable decibel range, in ALSA's hundredths of a decibel.
+struct DbRange {
+    long min_mdb = 0;
+    long max_mdb = 0;
+
+    bool usable() const { return max_mdb > min_mdb; }
+    // Full scale, which the curve is relative to. A control that can boost
+    // above unity must not do so, or every level is louder than its peers'.
+    long reference_mdb() const { return max_mdb < 0 ? max_mdb : 0; }
+};
+
+// Wire volume (0-100) <-> decibels, on the curve the player spec names.
+//
+// roles/player/v1.md: "Volume values (0-100) represent perceived loudness, not
+// linear amplitude ... Clients SHOULD convert volume to a linear amplitude
+// (the gain applied to samples, where 1.0 is full scale and 0 is silent) as
+// amplitude = (volume / 100)^1.5." In decibels that is 30*log10(volume/100)
+// below full scale, and the spec allows an equivalent dB-domain curve.
+//
+// Interpolating onto the control's raw range instead, as this daemon used to,
+// is the one thing the spec rules out: a hardware mixer's raw range is a ladder
+// of equal decibel steps, so on the HiFiBerry DAC+/Amp2's 207-step "Digital"
+// control, which spans -103.5 dB to 0 dB, a volume of 70 landed on -31 dB
+// instead of -4.65 dB. In a group with any conformant client that is a 26 dB
+// mismatch.
+long sendspin_to_mdb(uint8_t v, const DbRange& range);
+uint8_t mdb_to_sendspin(long mdb, const DbRange& range);
diff --git a/tests/test_volume_scale.cpp b/tests/test_volume_scale.cpp
index a7438fc..45ddf4e 100644
--- a/tests/test_volume_scale.cpp
+++ b/tests/test_volume_scale.cpp
@@ -1,5 +1,7 @@
 #include "volume_scale.h"
 #include <cassert>
+#include <cmath>
+#include <cstdint>
 
 int main() {
     // Sendspin wire volume is 0-100. full-scale endpoints
@@ -19,5 +21,68 @@ int main() {
     // clamp out-of-range raw
     assert(raw_to_sendspin(150, 0, 100) == 100);
     assert(raw_to_sendspin(-5, 0, 100) == 0);
+
+    // roles/player/v1.md: amplitude = (volume/100)^1.5, so 30*log10(volume/100)
+    // decibels below full scale. The HiFiBerry DAC+/Amp2 "Digital" control is
+    // 207 steps of 0.5 dB spanning -103.5 dB to 0 dB, wide enough for all of it.
+    const DbRange digital{-10350, 0};
+    assert(digital.usable());
+    assert(digital.reference_mdb() == 0);
+    assert(sendspin_to_mdb(0, digital) == -10350);
+    assert(sendspin_to_mdb(100, digital) == 0);
+
+    // The spec's own example: volume 50 is amplitude 0.5^1.5 = 0.354, -9.03 dB.
+    assert(sendspin_to_mdb(50, digital) == -903);
+    {
+        const double amplitude = std::pow(10.0, sendspin_to_mdb(50, digital) / 2000.0);
+        assert(amplitude > 0.350 && amplitude < 0.358);
+    }
+    // The conformance harness' non-conformant band for linear gain is 0.45-0.55.
+    assert(sendspin_to_mdb(70, digital) == -465);
+
+    // Strictly monotonic, so every step of the wire volume changes the level.
+    for (int v = 1; v <= 100; ++v) {
+        assert(sendspin_to_mdb(static_cast<uint8_t>(v), digital) >
+               sendspin_to_mdb(static_cast<uint8_t>(v - 1), digital));
+    }
+
+    // A level set from the server reads back as the same number.
+    for (int v = 0; v <= 100; ++v) {
+        const uint8_t wire = static_cast<uint8_t>(v);
+        assert(mdb_to_sendspin(sendspin_to_mdb(wire, digital), digital) == wire);
+    }
+
+    // Out-of-range inputs clamp, as on the raw scale.
+    assert(sendspin_to_mdb(171, digital) == 0);
+    assert(mdb_to_sendspin(-20000, digital) == 0);
+    assert(mdb_to_sendspin(500, digital) == 100);
+
+    // A narrow range cannot express the quietest levels and clamps to its floor
+    // rather than wrapping: a Softvol fallback control spans -51 dB to 0 dB, so
+    // everything below volume 2 sits on the floor.
+    const DbRange softvol{-5100, 0};
+    assert(sendspin_to_mdb(50, softvol) == -903);
+    assert(sendspin_to_mdb(1, softvol) == -5100);
+    assert(sendspin_to_mdb(2, softvol) > -5100);
+
+    // A control that can boost above unity stays at unity for volume 100, or it
+    // plays louder than every conformant peer in the same group.
+    const DbRange boosting{-10350, 400};
+    assert(boosting.reference_mdb() == 0);
+    assert(sendspin_to_mdb(100, boosting) == 0);
+    assert(sendspin_to_mdb(50, boosting) == -903);
+
+    // A control whose maximum is below unity references its own maximum.
+    const DbRange attenuating{-5000, -600};
+    assert(attenuating.reference_mdb() == -600);
+    assert(sendspin_to_mdb(100, attenuating) == -600);
+    assert(sendspin_to_mdb(50, attenuating) == -1503);
+
+    // A degenerate range must not divide by zero or curve anything.
+    const DbRange degenerate{0, 0};
+    assert(!degenerate.usable());
+    assert(sendspin_to_mdb(50, degenerate) == 0);
+    assert(mdb_to_sendspin(0, degenerate) == 0);
+
     return 0;
 }
