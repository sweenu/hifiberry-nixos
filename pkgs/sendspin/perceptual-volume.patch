+    use_db_ = resolve_db_range();
+    if (!use_db_) {
+        std::fprintf(stderr,
+                     "volume: control '%s' reports no usable decibel range; "
+                     "using the raw scale, which is not the curve the player "
+                     "spec asks for\n", control_.c_str());
+    }
     return true;
 }
 
+// Called from open(), which already holds the lock.
+bool VolumeControl::resolve_db_range() {
+    long min_mdb = 0, max_mdb = 0;
+    if (snd_mixer_selem_get_playback_dB_range(elem_, &min_mdb, &max_mdb) < 0) return false;
+
+    // Many DAC controls flag their bottom step as a hard mute, for which the
+    // reported minimum is the sentinel instead of a level. Probe upwards for
+    // the quietest step that has a real value.
+    if (min_mdb < DB_SENTINEL_FLOOR_MDB) {
+        const long limit = std::min(max_ - min_, MUTE_PROBE_STEPS);
+        bool found = false;
+        for (long step = 1; step <= limit && !found; ++step) {
+            long mdb = 0;
+            if (snd_mixer_selem_ask_playback_vol_dB(elem_, min_ + step, &mdb) == 0 &&
+                mdb > DB_SENTINEL_FLOOR_MDB) {
+                min_mdb = mdb;
+                found = true;
+            }
+        }
+        if (!found) return false;
+    }
+
+    db_ = DbRange{min_mdb, max_mdb};
+    return db_.usable();
+}
