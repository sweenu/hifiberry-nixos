+// ALSA reports SND_CTL_TLV_DB_GAIN_MUTE (-9999999) for a step that is a
+// hard mute rather than a level; anything this low is that sentinel.
+static constexpr long DB_SENTINEL_FLOOR_MDB = -20000;
+// How far above the bottom of the raw range to look for the quietest step
+// that carries a real decibel value.
+static constexpr long MUTE_PROBE_STEPS = 16;
+
 VolumeControl::VolumeControl(std::string device, std::string control)
     : device_(std::move(device)), control_(std::move(control)) {}
 
